# Docker Compose 2.30+ 필요. 이 파일을 env/deploy/.env.deploy로 복사하고 배포할 이미지 주소를 입력한다.
# 저장소 루트에서 docker compose --env-file env/deploy/.env.deploy up -d --wait로 실행한다.
# 앱 이미지는 CI에서 빌드·업로드하고, EC2에서는 pull해서 실행한다.
# 예: ghcr.io/sw-capstone/bareum-server:<git-sha>
SERVER_IMAGE=
# 예: ghcr.io/sw-capstone/bareum-ai:<git-sha>
AI_IMAGE=

# EC2의 HTTP 진입점. Spring·FastAPI 포트는 호스트에 공개하지 않는다.
HTTP_BIND_IP=0.0.0.0
HTTP_PORT=80

# 일반 실행 설정과 DB 접속 정보를 담는 앱 실행용 파일.
# Parameter Store 연동 시 조회한 비밀값을 이 파일에 채운다.
# raw 형식이므로 값에 따옴표를 붙이거나 ${...} 치환을 사용하지 않는다.
SERVER_ENV_FILE=./env/deploy/.env.server
# 현재 AI 앱은 실행 변수가 없어 파일이 없어도 된다.
AI_ENV_FILE=./env/deploy/.env.ai

# AWS 공식 RDS CA 번들을 EC2에 다운로드한 뒤 경로를 지정한다.
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
RDS_CA_FILE=./certs/rds-ca.pem
