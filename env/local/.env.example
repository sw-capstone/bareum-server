# 로컬 Spring HTTP 포트 (bootRun 실행용, 기본값: 8080)
SERVER_PORT=8080

# PostgreSQL 접속 정보 (로컬 데이터베이스 값으로 변경)
DB_URL=jdbc:postgresql://localhost:5432/bareum
DB_USERNAME=bareum
DB_PASSWORD=bareum-password

# Google 웹 OAuth Client ID 목록. 발급 값은 docs/integration/frontend-origins.md 참고. 미설정 시 차단합니다.
GOOGLE_CLIENT_IDS=
# 프론트 운영·develop 테스트 Origin. 실제 배포에서는 같은 값을 Parameter Store에 등록한다.
LOGIN_ALLOWED_ORIGINS=https://bareum.site,https://bareum-web-git-develop-numkites-projects.vercel.app
# 가입용 증명 600초는 팀 검토가 필요한 구현 초안입니다.
GOOGLE_SIGNUP_TTL_SECONDS=600

# 재설정 인증번호·완료 증명 유효기간(초), 인증 실패 허용 횟수.
# 운영 기본값은 제공하지 않으며 미설정 시 발송·확인을 차단합니다.
EMAIL_VERIFICATION_PASSWORD_RESET_CODE_TTL_SECONDS=
EMAIL_VERIFICATION_PASSWORD_RESET_VERIFICATION_TTL_SECONDS=
EMAIL_VERIFICATION_MAX_VERIFICATION_ATTEMPTS=
