{
  "openapi": "3.1.1",
  "info": {
    "title": "보고서 접수 및 파일 관리 계약",
    "version": "1.0.0",
    "description": "보고서 동기 접수, 분석 화면용 PDF 조회와 원본 삭제 요청을 제공한다."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/reports": {
      "post": {
        "operationId": "uploadReport",
        "summary": "PDF 보고서 동기 접수",
        "description": "원본 S3 저장, 파싱, 공통 본문과 파싱 이력 저장이 끝난 뒤 응답한다. PARTIAL도 성공이며 경고를 반환한다. 분석은 별도 요청한다. Spring 인스턴스별 신규 접수 동시 처리 수를 제한한다. 제한 초과 시 S3 저장과 접수 기록 생성 없이 503을 반환하며 같은 멱등 키로 나중에 다시 접수할 수 있다. 완료된 멱등 결과 재사용은 처리 자리를 점유하지 않는다.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "description": "같은 접수의 재전송은 같은 UUID를 사용한다. 새 접수는 새 UUID를 사용한다.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "reportType"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "비어 있지 않은 PDF 원본 1개. 중복 파일 파트는 허용하지 않는다.",
                    "x-max-size-bytes": 20000000,
                    "x-max-page-count": 60
                  },
                  "reportType": {
                    "type": "string",
                    "enum": [
                      "PLAN",
                      "RESULT"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "접수와 본문 저장 완료",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./success.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "필수값, 파일 개수, 문서 유형 또는 UUID 요청 키 오류",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "동일 요청 처리 중, 요청 지문 충돌 또는 취소한 접수",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "413": {
            "description": "20,000,000바이트 초과",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "415": {
            "description": "미지원 파일 형식",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "422": {
            "description": "60페이지 초과, 손상, 암호화 또는 추출 가능한 본문 없음",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "500": {
            "description": "파서 내부 오류 또는 저장 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "502": {
            "description": "외부 통신 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "503": {
            "description": "Spring 신규 접수 또는 AI 파싱 처리 용량 부족",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "504": {
            "description": "AI 응답 본문 수신을 포함한 대기시간 또는 접수 기한 초과",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/reports/{reportId}/preview": {
      "get": {
        "operationId": "getReportPreview",
        "summary": "분석 화면용 PDF 조회",
        "description": "REPORT-012. 접수를 완료한 본인 보고서의 PDF 접근 URL과 만료 시각을 반환한다. 원본이 PDF이면 원본을, 그 외에는 준비된 변환 PDF를 사용한다. 만료 시 다시 조회한다. 기본 유효기간은 600초이며 서버 설정으로 변경할 수 있다.",
        "parameters": [
          {
            "in": "path",
            "name": "reportId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF 접근 URL과 만료 시각",
            "headers": {
              "Cache-Control": {
                "schema": {"type": "string", "const": "no-store"}
              }
            },
            "content": {
              "application/json": {
                "schema": {"$ref": "./preview.schema.json"}
              }
            }
          },
          "400": {
            "description": "보고서 식별자 오류",
            "content": {
              "application/problem+json": {"schema": {"$ref": "./failure.schema.json"}}
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/problem+json": {"schema": {"$ref": "./failure.schema.json"}}
            }
          },
          "404": {
            "description": "보고서 접근 불가(REPORT-0038) 또는 PDF 없음(REPORT-0059)",
            "content": {
              "application/problem+json": {"schema": {"$ref": "./failure.schema.json"}}
            }
          },
          "409": {
            "description": "PDF 준비 미완료 또는 실패(REPORT-0058)",
            "content": {
              "application/problem+json": {"schema": {"$ref": "./failure.schema.json"}}
            }
          },
          "502": {
            "description": "PDF 저장소 조회 또는 접근 URL 발급 실패(REPORT-0060)",
            "content": {
              "application/problem+json": {"schema": {"$ref": "./failure.schema.json"}}
            }
          },
          "503": {
            "description": "보고서 저장소 설정 미완료(REPORT-0047)",
            "content": {
              "application/problem+json": {"schema": {"$ref": "./failure.schema.json"}}
            }
          }
        }
      }
    },
    "/reports/{reportId}/source": {
      "delete": {
        "operationId": "deleteReportSource",
        "summary": "미사용 접수 취소와 원본 삭제 요청",
        "description": "본인 소유의 파일 접수만 대상이다. 파싱 중이거나 분석 이력이 있으면 409로 거절한다. 삭제 요청은 접수 취소와 함께 저장한다. 취소된 접수로 분석하거나 완료 응답을 재사용할 수 없다. 본문과 파싱 이력은 유지한다.",
        "parameters": [
          {
            "in": "path",
            "name": "reportId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          }
        ],
        "responses": {
          "202": {
            "description": "삭제 요청 등록 또는 삭제 대기 중",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./source-deletion.schema.json"
                }
              }
            }
          },
          "204": {
            "description": "실제 삭제 완료"
          },
          "400": {
            "description": "보고서 식별자 형식 오류",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "파싱 중이거나 분석을 시작한 보고서",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "대상이 없거나 다른 사용자 소유",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./failure.schema.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "x-server-policy": {
    "maxFileSizeBytes": 20000000,
    "maxPageCount": 60,
    "idempotencyRetentionHoursAfterCompletion": 24,
    "idempotencyCleanupIntervalSeconds": 3600,
    "idempotencyScope": [
      "memberId",
      "requestKey"
    ],
    "fingerprintInputs": [
      "reportType",
      "originalFilename",
      "sizeBytes",
      "sha256"
    ],
    "activeDuplicateStatus": 409,
    "differentPayloadStatus": 409,
    "cancelledIntakeStatus": 409,
    "expiredKeyBehavior": "정리 작업으로 기록이 삭제되면 같은 키도 새 요청으로 처리될 수 있다.",
    "maxAdditionalParseAttempts": 1,
    "retryableParserErrors": [
      "SOURCE_URL_EXPIRED",
      "SOURCE_DOWNLOAD_TEMPORARY_FAILURE",
      "CAPACITY_EXCEEDED"
    ],
    "automaticRetryForTransportTimeout": false,
    "automaticRetryForParserTimeout": false,
    "retryDeadline": "접수 전체의 남은 시간 한도 안에서만 재시도한다.",
    "cleanup": "최종 실패나 접수 취소 시 저장된 파일을 소프트 삭제하고 S3 정리를 예약한다. 실제 S3 삭제가 완료되면 파일별로 완료 시각을 기록한다. 진행 중이거나 정리할 파일이 남은 멱등 기록은 만료돼도 삭제하지 않는다.",
    "sourceVersioning": "버전 관리 버킷은 업로드 응답의 versionId를 저장해 해당 버전을 삭제한다."
  }
}
