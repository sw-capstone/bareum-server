# Local HTTP port (default: 8080)
SERVER_PORT=8080

# PostgreSQL connection (replace with your local database values)
DB_URL=jdbc:postgresql://localhost:5432/bareum
DB_USERNAME=bareum
DB_PASSWORD=bareum-password

# Google web OAuth Client IDs (comma-separated). Empty disables Google login.
GOOGLE_CLIENT_IDS=
# Provisional signup proof lifetime, maximum 600 seconds
GOOGLE_SIGNUP_TTL_SECONDS=600
