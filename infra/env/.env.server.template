# prepare-server-env.sh가 이 템플릿의 일반 설정과 Parameter Store 값으로 .env.server를 생성한다.
# 생성된 .env.server는 Git에 올리지 않는다.
# raw 형식: 아래 값에 따옴표를 붙이지 않는다.

# Nginx upstream과 헬스체크가 8080을 사용하므로 서버 포트를 동일하게 유지한다.
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
SERVER_SHUTDOWN=graceful
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s
SPRING_JPA_SHOW_SQL=false

# Parameter Store의 /bareum/dev/server/에서 주입하는 값은 이 파일에 적지 않는다.
# DB_URL, DB_USERNAME, DB_PASSWORD
# EMAIL_VERIFICATION_HASH_SECRET, EMAIL_VERIFICATION_OUTBOX_ENCRYPTION_KEY
# SPRING_MAIL_HOST, SPRING_MAIL_USERNAME, SPRING_MAIL_PASSWORD, EMAIL_VERIFICATION_MAIL_FROM
# DB_URL은 sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-ca.pem을 포함한 RDS TLS 연결을 사용한다.

# 미처리 Outbox 작업이 남은 상태에서 암호화 키와 KEY_ID를 교체하지 않는다.
EMAIL_VERIFICATION_OUTBOX_KEY_ID=v1
EMAIL_VERIFICATION_OUTBOX_ENABLED=true

# SMTP 제공자의 587/STARTTLS 구성을 기준으로 한다.
SPRING_MAIL_PORT=587
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_CHECKSERVERIDENTITY=true

# SMTP 타임아웃: ms
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

# 개발 서버 임시 정책이며 팀 확정값이 아니다. 유효기간·최소 발송 간격: 초, 발송 제한: 횟수
AUTH_EMAILVERIFICATION_SIGNUPCODETTLSECONDS=300
AUTH_EMAILVERIFICATION_PASSWORDRESETCODETTLSECONDS=300
AUTH_EMAILVERIFICATION_MINIMUMSENDINTERVALSECONDS=60
AUTH_EMAILVERIFICATION_MAXSENDSPERHOUR=5
AUTH_EMAILVERIFICATION_MAXSENDSPERDAY=20
