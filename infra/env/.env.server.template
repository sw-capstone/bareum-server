# prepare-server-env.sh가 이 템플릿의 일반 설정과 Parameter Store의 DB 접속 정보로 .env.server를 생성한다.
# 생성된 .env.server는 Git에 올리지 않는다.
# raw 형식: 아래 값에 따옴표를 붙이지 않는다.

# Nginx upstream과 헬스체크가 8080을 사용하므로 서버 포트를 동일하게 유지한다.
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
SERVER_SHUTDOWN=graceful
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s
SPRING_JPA_SHOW_SQL=false

# RDS 엔드포인트·DB 이름·접속 계정으로 교체한다. CA·호스트 검증을 포함한 TLS 연결을 사용한다.
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/bareum?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-ca.pem
DB_USERNAME=
DB_PASSWORD=
